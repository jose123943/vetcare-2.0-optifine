# Copiar a .env; nunca guardar credenciales reales en Git.
# Conexión MySQL: valores reales del servicio, proporcionados fuera del código.
MYSQLHOST=
MYSQLPORT=
MYSQLDATABASE=
MYSQLUSER=
MYSQLPASSWORD=
# Identidad del servidor, dominio permitido y capacidad del pool por proceso.
VETCARE_SECRET_KEY=
VETCARE_PRODUCTION=false
VETCARE_ALLOWED_HOSTS=localhost,127.0.0.1
DB_POOL_SIZE=8
# Railway: volumen persistente /data, MEDIA_ROOT=/data/media
# MEDIA_ROOT=/data/media
# Envío independiente de notificaciones mediante el worker SMTP.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Gmail: contraseña de aplicación de Google; configurar con scripts/configurar_gmail.py.
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=
# Datos de la clínica que aparecerán en sus documentos.
VETCARE_NIT=
VETCARE_ADDRESS=
VETCARE_PHONE=
VETCARE_EMAIL=
# Procesos y threads del servidor Linux; ajustar junto con DB_POOL_SIZE.
WEB_CONCURRENCY=2
WEB_THREADS=4
