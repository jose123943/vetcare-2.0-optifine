# Copiar a .env; nunca guardar credenciales reales en Git.
MYSQLHOST=
MYSQLPORT=
MYSQLDATABASE=
MYSQLUSER=
MYSQLPASSWORD=
VETCARE_SECRET_KEY=
VETCARE_PRODUCTION=false
VETCARE_ALLOWED_HOSTS=localhost,127.0.0.1
DB_POOL_SIZE=8
# Railway: volumen persistente /data, MEDIA_ROOT=/data/media
# MEDIA_ROOT=/data/media
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Gmail: contraseña de aplicación de Google; configurar con scripts/configurar_gmail.py.
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=
VETCARE_NIT=
VETCARE_ADDRESS=
VETCARE_PHONE=
VETCARE_EMAIL=
WEB_CONCURRENCY=2
WEB_THREADS=4
