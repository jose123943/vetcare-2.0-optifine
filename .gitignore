# Indica qué archivos privados, temporales o generados deben quedar fuera de Git.
.env
.env.*
!.env.example
.venv/
.venv-wsgi/
venv/
__pycache__/
.ruff_cache/
*.py[cod]
staticfiles/
db.sqlite3
media/
.test_media/
private_backups/
*.sql
!sql/*.sql
*.dump
dist/
build/
# Capturas y PDF de pruebas: se generan al ejecutar los recorridos del navegador.
docs/evidencias/*.png
docs/evidencias/*.pdf
